Reverse an Array
#---------------------2 array approach-------------------------
class Solution {
    public void reverseArray(int arr[]) {
        if (arr == null || arr.length == 0) return;

        int[] reversed = new int[arr.length];
        int j = arr.length - 1;

        for (int i = 0; i < arr.length; i++) {
            reversed[i] = arr[j--];
        }

        for (int i = 0; i < arr.length; i++) {
            arr[i] = reversed[i];
        }
    }
}

#------------------Temp Variable approach(optimal)--------------------
class Solution {
    public void reverseArray(int arr[]) {
        int start=0,end=arr.length-1;
        
        while(start<end){
            int temp=arr[start];
            arr[start]=arr[end];
            arr[end]=temp;
            start++;
            end--;
            
        }
    }
}

